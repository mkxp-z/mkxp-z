 #include "insns.inc"
 #include "insns_info.inc"
 
+/**
+ * Makes it so that a method is only visible to Ruby scripts if syntax transform is enabled
+ * and is currently targeting a Ruby version that is less than or equal to
+ * the version given by `maximum_target_ruby_version_major`,
+ * `maximum_target_ruby_version_minor` and `maximum_target_ruby_version_teeny`
+ */
+void
+mkxp_set_syntax_transform_target_for_method(VALUE receiver, const char *method_name, unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor, unsigned int maximum_target_ruby_version_teeny)
+{
+    const rb_callable_method_entry_t *cme = rb_callable_method_entry(receiver, rb_intern(method_name));
+    if (cme == NULL) {
+        VALUE rb_make_no_method_exception(VALUE, VALUE, VALUE, int, const VALUE *, int);
+        VALUE method_name_value = rb_str_new_cstr(method_name);
+        VALUE exc = rb_make_no_method_exception(rb_eNoMethodError, 0, receiver, 1, &method_name_value, 0);
+        rb_exc_raise(exc);
+    }
+    cme->def->mkxp_syntax_transform_maximum_target_ruby_version_major_plus_one = maximum_target_ruby_version_major + 1;
+    cme->def->mkxp_syntax_transform_maximum_target_ruby_version_minor_plus_one = maximum_target_ruby_version_minor + 1;
+    cme->def->mkxp_syntax_transform_maximum_target_ruby_version_teeny_plus_one = maximum_target_ruby_version_teeny + 1;
+}
+
+/**
+ * Check if mkxp syntax transform is active in the scope that `iseq` is in
+ * and is currently targeting a Ruby version that is less than or equal to
+ * the version given by `maximum_target_ruby_version_major`,
+ * `maximum_target_ruby_version_minor` and `maximum_target_ruby_version_teeny`
+ */
+bool
+mkxp_iseq_is_syntax_transform_active(const rb_iseq_t *iseq, unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor, unsigned int maximum_target_ruby_version_teeny)
+{
+    extern unsigned int mkxp_syntax_transform_target_ruby_version_major, mkxp_syntax_transform_target_ruby_version_minor, mkxp_syntax_transform_target_ruby_version_teeny;
+    if (mkxp_syntax_transform_target_ruby_version_major > maximum_target_ruby_version_major || (mkxp_syntax_transform_target_ruby_version_major == maximum_target_ruby_version_major && (mkxp_syntax_transform_target_ruby_version_minor > maximum_target_ruby_version_minor || (mkxp_syntax_transform_target_ruby_version_minor == maximum_target_ruby_version_minor && mkxp_syntax_transform_target_ruby_version_teeny > maximum_target_ruby_version_teeny)))) {
+        return FALSE;
+    }
+
+    return iseq->body->param.flags.mkxp_syntax_transform_flag;
+}
+
+bool
+mkxp_ec_is_syntax_transform_active0(const rb_execution_context_t *ec, unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor, unsigned int maximum_target_ruby_version_teeny)
+{
+    extern unsigned int mkxp_syntax_transform_target_ruby_version_major, mkxp_syntax_transform_target_ruby_version_minor, mkxp_syntax_transform_target_ruby_version_teeny;
+    if (mkxp_syntax_transform_target_ruby_version_major > maximum_target_ruby_version_major || (mkxp_syntax_transform_target_ruby_version_major == maximum_target_ruby_version_major && (mkxp_syntax_transform_target_ruby_version_minor > maximum_target_ruby_version_minor || (mkxp_syntax_transform_target_ruby_version_minor == maximum_target_ruby_version_minor && mkxp_syntax_transform_target_ruby_version_teeny > maximum_target_ruby_version_teeny)))) {
+        return FALSE;
+    }
+
+    {
+        const rb_control_frame_t *cfp, *end_cfp;
+        if (ec == NULL) {
+            return FALSE;
+        }
+        cfp = ec->cfp;
+        if (cfp == NULL) {
+            return FALSE;
+        }
+        for (end_cfp = RUBY_VM_END_CONTROL_FRAME(ec); RUBY_VM_VALID_CONTROL_FRAME_P(cfp, end_cfp); cfp = RUBY_VM_PREVIOUS_CONTROL_FRAME(cfp)) {
+            if (VM_FRAME_RUBYFRAME_P(cfp)) {
+                return cfp->iseq->body->param.flags.mkxp_syntax_transform_flag;
+            }
+        }
+        return FALSE;
+    }
+}
+
+/**
+ * Check if mkxp syntax transform is active in the current execution context
+ * and is currently targeting a Ruby version that is less than or equal to
+ * the version given by `maximum_target_ruby_version_major`,
+ * `maximum_target_ruby_version_minor` and `maximum_target_ruby_version_teeny`
+ */
+bool
+mkxp_ec_is_syntax_transform_active(unsigned int maximum_target_ruby_version_major, unsigned int maximum_target_ruby_version_minor, unsigned int maximum_target_ruby_version_teeny)
+{
+    return mkxp_ec_is_syntax_transform_active0(GET_EC(), maximum_target_ruby_version_major, maximum_target_ruby_version_minor, maximum_target_ruby_version_teeny);
+}
+
+bool
+mkxp_syntax_transform_is_method_available0(const rb_execution_context_t *ec, struct rb_method_definition_struct *method)
+{
+    return (
+        (
+            method == NULL
+        ) || (
+            method->mkxp_syntax_transform_maximum_target_ruby_version_major_plus_one == 0
+                && method->mkxp_syntax_transform_maximum_target_ruby_version_minor_plus_one == 0
+                && method->mkxp_syntax_transform_maximum_target_ruby_version_teeny_plus_one == 0
+        ) || (
+            mkxp_ec_is_syntax_transform_active0(
+                ec,
+                method->mkxp_syntax_transform_maximum_target_ruby_version_major_plus_one - 1,
+                method->mkxp_syntax_transform_maximum_target_ruby_version_minor_plus_one - 1,
+                method->mkxp_syntax_transform_maximum_target_ruby_version_teeny_plus_one - 1
+            )
+        )
+    );
+}
+
+bool
+mkxp_syntax_transform_is_method_available(struct rb_method_definition_struct *method)
+{
+    return mkxp_syntax_transform_is_method_available0(GET_EC(), method);
+}

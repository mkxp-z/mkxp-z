-)
+).partial_dependency(compile_args: true, includes: true, link_args: host_machine.system() not in ['windows', 'cygwin'] and not dl_dep.found(), links: host_machine.system() not in ['windows', 'cygwin'] and not dl_dep.found(), sources: true)

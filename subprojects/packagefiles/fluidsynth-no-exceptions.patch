# Allows FluidSynth to compile with C++ exceptions and RTTI disabled.

--- a/src/midi/fluid_seq_queue.cpp
+++ b/src/midi/fluid_seq_queue.cpp
@@ -22,7 +22,7 @@
 #include <deque>
 #include <algorithm>
 #include <limits>
-
+#include "../../../src/mkxp-polyfill.h"
 /*
  * This is an implementation of an event queue, sorted according to their timestamp.
  *
@@ -118,7 +118,7 @@ int event_compare_for_test(const fluid_event_t* left, const fluid_event_t* right
 
 void* new_fluid_seq_queue(int nb_events)
 {
-    try
+    MKXPZ_TRY
     {
         // As workaround for a missing deque::reserve(), allocate a deque with a size of nb_events
         seq_queue_t* queue = new seq_queue_t(nb_events);
@@ -129,7 +129,7 @@ void* new_fluid_seq_queue(int nb_events)
 
         return queue;
     }
-    catch(...)
+    MKXPZ_CATCH(...)
     {
         return 0;
     }
@@ -142,7 +142,7 @@ void delete_fluid_seq_queue(void *que)
 
 int fluid_seq_queue_push(void *que, const fluid_event_t *evt)
 {
-    try
+    MKXPZ_TRY
     {
         seq_queue_t& queue = *static_cast<seq_queue_t*>(que);
 
@@ -151,7 +151,7 @@ int fluid_seq_queue_push(void *que, const fluid_event_t *evt)
 
         return FLUID_OK;
     }
-    catch(...)
+    MKXPZ_CATCH(...)
     {
         return FLUID_FAILED;
     }

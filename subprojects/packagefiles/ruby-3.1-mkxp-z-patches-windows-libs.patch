# Undoes the inclusion of `-lz` and `-lffi` from ruby-3.1-mkxp-z-patches.patch, since it causes build errors if zlib and libffi don't exist on the build machine.
# Also makes the inclusion of `-lgcc` conditional on whether or not libgcc exists since Clang does not have libgcc, resulting in linker errors when attempting to build Ruby for Windows with Clang.

--- a/configure.ac
+++ b/configure.ac
@@ -1170,7 +1170,7 @@ main()
 		AC_CHECK_FUNCS(cygwin_conv_path)
 		AC_LIBOBJ([langinfo])
 		],
-[mingw*], [	LIBS="-lshell32 -lws2_32 -liphlpapi -limagehlp -lshlwapi -lbcrypt -Wl,-Bstatic -lgcc -lpthread -lz -lffi -Wl,-Bdynamic $LIBS"
+[mingw*], [	LIBS="-lshell32 -lws2_32 -liphlpapi -limagehlp -lshlwapi -lbcrypt -Wl,-Bstatic $MKXP_LIBGCC -lpthread -Wl,-Bdynamic $LIBS"
 		ac_cv_header_pwd_h=no
 		ac_cv_header_utime_h=no
 		ac_cv_header_sys_ioctl_h=no

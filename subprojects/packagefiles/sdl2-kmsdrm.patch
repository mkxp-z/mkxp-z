+    'render'        : { 'opt' : opt_render,     'deps' : [], 'opt_deps' : [vulkan_dep] + kmsdrm_deps + x11_deps + wayland_deps + gl_deps },
     'sensor'        : { 'opt' : opt_sensor,     'deps' : [], 'opt_deps' : [] },
     'threads'       : { 'opt' : opt_threads,    'deps' : [threads_dep], 'opt_deps' : [] },
     'timers'        : { 'opt' : opt_timers,     'deps' : [], 'opt_deps' : [] },
-    'video'         : { 'opt' : opt_video,      'deps' : [], 'opt_deps' : [vulkan_dep] + x11_deps + wayland_deps + gl_deps },
+    'video'         : { 'opt' : opt_video,      'deps' : [], 'opt_deps' : [vulkan_dep] + kmsdrm_deps + x11_deps + wayland_deps + gl_deps },
 }
 
 enabled_subsystems = []
@@ -1024,6 +1042,10 @@ if extra_deps.contains(vulkan_dep)

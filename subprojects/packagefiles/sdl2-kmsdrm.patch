 endif
 
+if libdrm_dep.found() and extra_deps.contains(libdrm_dep)
+    sys_video_driver += 'kmsdrm'
+endif
+
 if x11_dep.found() and extra_deps.contains(x11_dep)
     sys_video_driver += 'x11'
     if extra_deps.contains(glx_dep)

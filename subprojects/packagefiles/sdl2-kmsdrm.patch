# Enables support for SDL's KMSDRM video driver.

--- a/meson.build
+++ b/meson.build
@@ -105,6 +105,7 @@ opt_threads = get_option('use_threads')
 opt_timers = get_option('use_timers')
 opt_video = get_option('use_video')
 
+opt_video_kmsdrm = get_option('use_video_kmsdrm')

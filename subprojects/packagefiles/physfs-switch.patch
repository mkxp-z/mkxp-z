# Nintendo Switch (libnx) support: a POSIX platform without CD-ROM support,
# whose base, pref and user directories are the working directory.

--- a/src/physfs_platform_posix.c
+++ b/src/physfs_platform_posix.c
@@ -85,6 +85,12 @@
 
 char *__PHYSFS_platformCalcUserDir(void)
 {
+#ifdef __SWITCH__
+    /* Nintendo Switch: everything is relative to the working directory */
+    char *switch_retval = (char *) allocator.Malloc(3);
+    if (switch_retval) strcpy(switch_retval, "./");
+    return switch_retval;
+#endif
     char *retval = NULL;
     char *envr = getenv("HOME");
 

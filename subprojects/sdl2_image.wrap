[wrap-git]
url = https://github.com/libsdl-org/SDL_image
revision = release-2.6.3
depth = 1
clone-recursive = true
method = cmake
diff_files =
    sdl2_image-deps.patch,
    sdl2_image-highway-exit.patch,
    sdl2_image-highway-rvv.patch,
    sdl2_image-libjxl-enc.patch,
    sdl2_image-libjxl-examples-tools.patch,
    sdl2_image-libjxl-static.patch,
    sdl2_image-zlib-windres.patch,
    end-of-diff-files.patch

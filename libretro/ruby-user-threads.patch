@@ -149,18 +194,35 @@ ruby_init_stack(volatile VALUE *addr)
 static int
 native_thread_init_stack(rb_thread_t *th)
 {
-#if defined(__wasm__) && !defined(__EMSCRIPTEN__)
-    th->ec->machine.stack_start = (VALUE *)rb_wasm_stack_get_base();
-#endif
-    return 0; // success
+    static bool is_main_thread = true;
+    if (UNLIKELY(is_main_thread)) {
+        is_main_thread = false;
+        void mkxp_thread_main_stack_initialize(rb_thread_t *);
+        mkxp_thread_main_stack_initialize(th);
+    } else {
+        void mkxp_thread_stack_initialize(rb_thread_t *);
+        mkxp_thread_stack_initialize(th);
+    }
+    return 0;
+}
+
+__attribute__((noinline)) void
+mkxp_thread_entry_point(rb_thread_t *th)
+{
+    native_thread_init_stack(th);
+    rb_wasm_set_stack_pointer(th->ec->machine.stack_start);
+    thread_start_func_2(th, th->ec->machine.stack_start);
+
+    void mkxp_thread_unschedule(rb_thread_t *);
+    mkxp_thread_unschedule(th);
 }
 

# This patch enables a custom user thread implementation for WASI builds of Ruby to allow threads to be created from Ruby without OS thread support.
# It also handles `Kernel#sleep`. Without this patch, `Kernel#sleep` freezes the VM in WASI builds of Ruby.

--- a/thread.c
+++ b/thread.c
@@ -1252,10 +1252,8 @@ NOINLINE(rb_hrtime_t rb_hrtime_now(void));
 rb_hrtime_t
 rb_hrtime_now(void)
 {
-    struct timespec ts;
-
-    getclockofday(&ts);
-    return rb_timespec2hrtime(&ts);
+    uint64_t mkxp_thread_timestamp(void);
+    return mkxp_thread_timestamp();
 }
 
